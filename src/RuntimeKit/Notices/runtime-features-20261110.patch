+/* Match IOS_MFIJoystickUpdate's exact compact button/axis order. This
+ * supplies the existing SDL automatic-mapping path when the retained core's
+ * built-in database was compiled without SDL_JOYSTICK_MFI mappings. */
+static SDL_bool RRBuildMFIMap(int naxes, int nhats, int nbuttons, Uint32 mask, SDL_GamepadMapping *out)
+{
+    if (!out) return SDL_FALSE;
+    SDL_zero(*out);
+    const Uint32 base_mask = (1u << SDL_CONTROLLER_BUTTON_A) | (1u << SDL_CONTROLLER_BUTTON_B) |
+        (1u << SDL_CONTROLLER_BUTTON_X) | (1u << SDL_CONTROLLER_BUTTON_Y) |
+        (1u << SDL_CONTROLLER_BUTTON_LEFTSHOULDER) | (1u << SDL_CONTROLLER_BUTTON_RIGHTSHOULDER) |
+        (1u << SDL_CONTROLLER_BUTTON_START);
+    const Uint32 optional_mask = (1u << SDL_CONTROLLER_BUTTON_LEFTSTICK) | (1u << SDL_CONTROLLER_BUTTON_RIGHTSTICK) |
+        (1u << SDL_CONTROLLER_BUTTON_BACK) | (1u << SDL_CONTROLLER_BUTTON_GUIDE);
+    if ((naxes != 0 && naxes != 6) || nhats != 1 || nbuttons < 7 || nbuttons > 11 ||
+        (mask & base_mask) != base_mask || (mask & ~(base_mask | optional_mask))) return SDL_FALSE;
+    SDL_InputMapping *base[] = {&out->a, &out->b, &out->x, &out->y, &out->leftshoulder, &out->rightshoulder};
+    for (int i = 0; i < 6; ++i) { base[i]->kind = EMappingKind_Button; base[i]->target = (Uint8)i; }
+    int button = 6;
+#define RR_MFI_BUTTON(field, name) if (mask & (1u << name)) { out->field.kind = EMappingKind_Button; out->field.target = (Uint8)button++; }
+    RR_MFI_BUTTON(leftstick, SDL_CONTROLLER_BUTTON_LEFTSTICK);
+    RR_MFI_BUTTON(rightstick, SDL_CONTROLLER_BUTTON_RIGHTSTICK);
+    RR_MFI_BUTTON(back, SDL_CONTROLLER_BUTTON_BACK);
+    RR_MFI_BUTTON(guide, SDL_CONTROLLER_BUTTON_GUIDE);
+    RR_MFI_BUTTON(start, SDL_CONTROLLER_BUTTON_START);
+#undef RR_MFI_BUTTON
+    if (button != nbuttons) { SDL_zero(*out); return SDL_FALSE; }
+    SDL_InputMapping *hats[] = {&out->dpup, &out->dpdown, &out->dpleft, &out->dpright};
+    Uint8 directions[] = {SDL_HAT_UP, SDL_HAT_DOWN, SDL_HAT_LEFT, SDL_HAT_RIGHT};
+    for (int i = 0; i < 4; ++i) { hats[i]->kind = EMappingKind_Hat; hats[i]->target = directions[i]; }
+    if (naxes == 6) {
+        SDL_InputMapping *axes[] = {&out->leftx, &out->lefty, &out->lefttrigger, &out->rightx, &out->righty, &out->righttrigger};
+        for (int i = 0; i < 6; ++i) { axes[i]->kind = EMappingKind_Axis; axes[i]->target = (Uint8)i; }
+    }
+    return SDL_TRUE;
+}
