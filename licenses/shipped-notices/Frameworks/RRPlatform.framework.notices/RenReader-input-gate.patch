+int SDL_PushEvent(SDL_Event *event)
+{
+    int result, admission = RRInputGateEnterPost(event);
+    SDL_Event submitted;
+    if (!admission) return 0;
+    submitted = *event;
+    result = RRSDL_SDL_PushEvent(event);
